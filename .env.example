# PXGPT Environment Configuration
#
# pxGPT reads the PROCESS ENVIRONMENT — it never loads a .env file by itself.
# Copy this file, fill in your keys, then EXPORT it:
#
#     cp .env.example project_A.env
#     set -a; source project_A.env; set +a
#
# Plain `source` is not enough (the variables would not reach pxgpt).
#
# The file is split into three parts:
#   1. SHARED        — apply to every provider
#   2. ANTHROPIC     — only read when talking to Anthropic
#   3. OPENAI        — only read when talking to OpenAI
#   4. LOCAL         — self-hosted providers (analyze + schema only)


# ══════════════════════════════════════════════════════════════════════════════
# 1. SHARED — these apply to BOTH providers
# ══════════════════════════════════════════════════════════════════════════════

# Which provider the commands talk to by default.
# Options: anthropic, openai, ollama, lmstudio, vllm
DEFAULT_PROVIDER=anthropic

# ── Reasoning effort, per pipeline stage ──────────────────────────────────────
# One vocabulary for both providers:
#
#   Levels : low | medium | high | xhigh | max
#   OFF    : empty (the default) | off | none      ← all three mean the same
#
# "OFF" is spelled differently on the wire, and pxGPT handles that for you:
#   Anthropic → thinking: {"type": "disabled"} on claude-sonnet-5 and newer
#   OpenAI    → reasoning: {"effort": "none"}
# For OpenAI this MATTERS: leaving the parameter out does not disable reasoning,
# the model falls back to its own default (medium on gpt-5.6).  pxGPT therefore
# always sends an explicit level.
#
# Note: OpenAI's older "minimal" level is not offered here — gpt-5.6 dropped it.

# Stage 1 — describe-batch (Anthropic) and describe-batch-openai (OpenAI).
# Both commands accept --effort, which overrides this per run.
DESCRIBE_EFFORT=

# Stage 3 — phenotype-batch (Anthropic) and phenotype-batch-openai (OpenAI).
# Neither command has an --effort flag; this variable is the only control.
# The sync `schema` command reads it too, and does accept --effort.
STAGE3_EFFORT=

# Sync `analyze` command.  Also accepts --effort.
ANALYZE_EFFORT=

# ── Sampling ──────────────────────────────────────────────────────────────────
# Temperature is only sent when reasoning is OFF, and even then only where the
# model accepts a custom value:
#   Anthropic → sent on Sonnet 4.6 and earlier; claude-sonnet-5 and newer reject
#               a custom value outright, so it is omitted
#   OpenAI    → sent when effort is "none"; any other level returns a 400, so it
#               is omitted
# Both guards are automatic — the run banner reports what was actually sent.
TEMPERATURE=0.5

# ── Token budgets ─────────────────────────────────────────────────────────────
# Sync (analyze / schema) calls.
MAX_TOKENS=16384
# Per-request budgets for the batch stages.
STAGE1_MAX_TOKENS=16384
STAGE3_MAX_TOKENS=16384

# ── Files API and transport ───────────────────────────────────────────────────
# Upload each image once and reference it by file_id (default).  Set false — or
# pass --no-files-api — to embed images inline as base64 in every request.
USE_FILES_API=true
# Number of parallel image upload threads for the Files API.
UPLOAD_CONCURRENCY=10

MAX_RETRIES=3
TIMEOUT=300
# Seconds to sleep after a 429 rate-limit error.
RATE_LIMIT_SLEEP=60


# ══════════════════════════════════════════════════════════════════════════════
# 2. ANTHROPIC — only used when the provider is anthropic
# ══════════════════════════════════════════════════════════════════════════════

# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# claude-sonnet-5 is the default.  Change here to switch globally.
ANTHROPIC_MODEL=claude-sonnet-5

# Set to true to add the output-300k-2026-03-24 beta header on Stage 1 batches,
# raising the per-response output cap from 64 k to 300 k tokens.
BATCH_300K_OUTPUT=false


# ══════════════════════════════════════════════════════════════════════════════
# 3. OPENAI — only used when the provider is openai
# ══════════════════════════════════════════════════════════════════════════════

# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# gpt-5.6-luna is the default.  Change here to switch globally.
# Reasoning effort comes from DESCRIBE_EFFORT / STAGE3_EFFORT in the shared
# section above — there is no OpenAI-specific effort variable.
OPENAI_MODEL=gpt-5.6-luna

# Override the API endpoint (self-hosted / proxy / Azure-style gateway).
# Leave empty to use the official OpenAI endpoint.
OPENAI_BASE_URL=

# Completion window passed to the OpenAI Batch API.
OPENAI_BATCH_COMPLETION_WINDOW=24h


# ══════════════════════════════════════════════════════════════════════════════
# 4. LOCAL / self-hosted providers — `analyze` and `schema` only
# ══════════════════════════════════════════════════════════════════════════════
# The batch stages are Anthropic/OpenAI-only.  See README.md for the full set of
# OLLAMA_* / LMSTUDIO_* / VLLM_* variables.

OLLAMA_BASE_URL=http://localhost:11434
