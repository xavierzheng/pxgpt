# PXGPT Environment Configuration
# Copy this file to .env and fill in your API keys

# Anthropic API Key
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Ollama Configuration (for local models)
OLLAMA_BASE_URL=http://localhost:11434

# Default Provider
# Options: anthropic, openai, ollama, lmstudio, vllm
DEFAULT_PROVIDER=anthropic

# ── Anthropic model ────────────────────────────────────────────────────────────
# claude-sonnet-5 is the default.  Change here to switch globally.
ANTHROPIC_MODEL=claude-sonnet-5

# ── OpenAI model ───────────────────────────────────────────────────────────────
# Used by the openai provider and by describe-batch-openai / phenotype-batch-openai.
# gpt-5.6-luna is the default.  Change here to switch globally.
OPENAI_MODEL=gpt-5.6-luna

# Override the API endpoint (self-hosted / proxy / Azure-style gateway).
# Leave empty to use the official OpenAI endpoint.
OPENAI_BASE_URL=

# Reasoning effort — applies only to reasoning models (gpt-5, o-series).
# Values: minimal | low | medium | high, or empty/off/none to send no reasoning
# param.  Those models also reject a custom TEMPERATURE, which pxGPT omits for
# them automatically.
OPENAI_REASONING_EFFORT=

# Completion window passed to the OpenAI Batch API.
OPENAI_BATCH_COMPLETION_WINDOW=24h

# ── Sync API settings ──────────────────────────────────────────────────────────
MAX_RETRIES=3
TIMEOUT=300
# Temperature — sent only when reasoning is OFF *and* ANTHROPIC_MODEL is Sonnet
# 4.6 or earlier.  With reasoning on, the API forces its default; claude-sonnet-5
# and newer reject a custom value even with reasoning off, so pxGPT omits it and
# sends thinking: {"type": "disabled"} instead.  The guard is automatic.
TEMPERATURE=0.5
# Max tokens for sync (analyze / schema) calls — claude-sonnet-4-6 supports 64 k.
MAX_TOKENS=16384

# ── Batch API settings ─────────────────────────────────────────────────────────
# Per-request token budgets for batch stages.
STAGE1_MAX_TOKENS=16384
STAGE3_MAX_TOKENS=16384

# Adaptive thinking effort for Stage 3 and the schema command.
# Empty (the default) / off / none all mean no reasoning; set a level to enable.
# Values: low | medium | high | xhigh | max
STAGE3_EFFORT=

# Set to true to add the output-300k-2026-03-24 beta header on Stage 1 batches,
# raising the per-response output cap from 64 k to 300 k tokens.
BATCH_300K_OUTPUT=false

# Number of parallel image upload threads for the Files API.
UPLOAD_CONCURRENCY=10

# Seconds to sleep after a 429 rate-limit error.
RATE_LIMIT_SLEEP=60
