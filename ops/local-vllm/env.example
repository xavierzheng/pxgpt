# pxGPT local vLLM on DGX Spark (GB10 / sm_121) -- copy to .env and source it.
#   cp env.example .env && ./pull.sh && ./up.sh
# .env is gitignored; env.example is version-controlled.

# --- image + weights (both pinned; see RUNBOOK.md) --------------------------
# Filled in by pull.sh. Must be name@sha256:... -- never a floating tag.
VLLM_IMAGE=<FILL>
# HF repo and the exact commit sha. Both are required for reproducibility.
MODEL_REPO=unsloth/gemma-4-26B-A4B-it-NVFP4
MODEL_REVISION=<FILL>

# --- server ----------------------------------------------------------------
SERVED_MODEL_NAME=gemma4-26b-a4b-nvfp4
CONTAINER_NAME=pxgpt-vllm
PORT=8000
# Absolute path to the photo root; passed to --allowed-local-media-path and
# bind-mounted read-only at the SAME path inside the container, so the
# file:// URLs pxgpt sends resolve identically on both sides.
# It is a PREFIX, not a list: any subfolder under it resolves.  Point it at the
# project root rather than one dataset's images, so a run against a different
# dataset does not need a server restart -- the value is baked into the running
# container and can only be changed with down.sh + up.sh.
# A path outside it fails with 400 "must be a subpath of
# --allowed-local-media-path"; a path inside it that is missing fails with 500.
MEDIA_ROOT=<FILL>
HF_HOME=$HOME/.cache/huggingface
MAX_MODEL_LEN=65536
# Raised from 2: costs no memory (the KV cache is preallocated from
# GPU_MEM_UTIL, not from the sequence count) and lets a plant's warm shards run
# 3.4x faster at concurrency 8. See RUNBOOK.md "Concurrency".
MAX_NUM_SEQS=16
# Do not raise past 0.80 without re-running acceptance E; the unified memory
# pool is shared with the OS and page cache. See RUNBOOK "known failure modes".
GPU_MEM_UTIL=0.80

# --- pinned runtime selections (see RUNBOOK "Pinned runtime selections") ---
# Which MoE kernel serves the NVFP4 experts. Left unset, vLLM walks a priority
# list and takes the first backend that supports the deployment; the log then
# names the winner. Pinning states the choice instead of inheriting whatever
# that list happens to rank first in the next image.
#
# NOTE THE TWO SPELLINGS. This is the *CLI* value and the CLI only accepts
# lowercase names (auto, cutlass, flashinfer_cutlass, marlin, ...). `cutlass`
# here is the backend the startup log calls VLLM_CUTLASS -- the mapping is in
# vllm/model_executor/layers/fused_moe/oracle/nvfp4.py::map_nvfp4_backend.
# Passing VLLM_CUTLASS verbatim makes vLLM exit with "invalid choice".
#
# Chosen over the FLASHINFER_CUTLASS path that auto-selection currently picks
# because the image ships flashinfer-python 0.6.6, below the model card's
# recommended >=0.6.13. Cost measured, see RUNBOOK.
MOE_BACKEND=cutlass

# --- sampling: one set of values, consumed on BOTH sides --------------------
# These are the checkpoint's own generation_config.json values, now stated
# rather than inherited silently. up.sh passes them to the server via
# --override-generation-config; smoke.py and bench.sh also send them on every
# request. Server-side alone would keep them out of the request record; client-
# side alone would let any client that forgets them fall back to Google's
# checkpoint defaults with no warning. Same variables both sides, so the two
# layers cannot disagree.
TEMPERATURE=0.5
TOP_P=0.95
TOP_K=64
# Deliberately NO seed. vLLM accepts a per-request seed, and setting one would
# make repeated inference of the same plant return byte-identical output with
# zero variance and no error message -- which is precisely the measurement the
# consistency study depends on.

# --- pinned experiment decisions (see RUNBOOK.md for the evidence) ---------
# Thinking mode. The chat template defaults enable_thinking=false and pre-fills
# an empty <|channel>thought\n<channel|> block, so generation starts at the
# answer and a response_format grammar applies cleanly from the first token.
ENABLE_THINKING=false
# Visual token budget per image. Supported ladder: 70 140 280 560 1120.
# The checkpoint's processor_config.json defaults to 280; we deliberately run at
# the top of the ladder (1120) because the Stage 3 traits are fine-grained
# (petiole cross-section, colour hue, leaf margin) and because 1120 lands close
# to Anthropic Sonnet 5's per-image tokenization, keeping local and cloud runs
# comparable.
# Cost: 32 photos x 1120 ~= 37 k prompt tokens, well inside MAX_MODEL_LEN=65536,
# but materially slower than 280 -- see RUNBOOK.md "Decision (b)".
IMAGE_TOKEN_BUDGET=1120

# --- real data used by smoke.py / bench.sh (READ-ONLY; never written) ------
# The shard set is frozen, chmod -w and under human evaluation.
SHARD_DIR=/home/xavier/project/pxgpt/03_mature_v2/shard_master_schema
SYSTEM_PROMPT=/home/xavier/project/pxgpt/03_mature_v2/phenotyping_schema_system.txt
# Plant line with the most photos in the dataset -- used for acceptance E.
BENCH_LINE=s0019
# A line this server has not served yet, for the cold-prefill probe in bench.sh.
BENCH_COLD_LINE=s0044
